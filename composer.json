{
    "require": {
        "krubio/perfect-router": "^0.2.0",
        "krubio/perfect-session": "^0.1.2",
        "krubio/perfect-logger": "^0.1.0",
        "krubio/perfect-database": "^0.1.0",
        "krubio/perfect-container-psr-11": "^2.0",
        "ext-pdo": "*",
        "ext-ctype": "*",
        "ext-zip": "*"
    },
    "autoload": {
        "psr-4": {
            "PerfectConsign\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PerfectConsign\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "chrome-php/chrome": "1.16",
        "phpmd/phpmd": "2.15",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "13.3.5"
    },
    "scripts": {
        "check:max-lines": "php bin/check-max-lines.php 500",
        "check:phpmd": "php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" vendor/bin/phpmd src text phpmd.xml",
        "probe:phpmd": "php bin/phpmd-probe-rule.php",
        "phpstan": "php vendor/bin/phpstan analyse --memory-limit=512M",
        "test": "php vendor/bin/phpunit --testsuite unit",
        "test:smoke": "php vendor/bin/phpunit --testsuite http --group smoke",
        "test:http": "php vendor/bin/phpunit --testsuite http",
        "test:browser": "php vendor/bin/phpunit --testsuite browser",
        "test:coverage": "php bin/coverage-run.php",
        "test:mutate": "php bin/mutate.php",
        "check": [
            "@check:max-lines",
            "@check:phpmd",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
