{
    "require": {
        "php": "^8.5",
        "krubio/perfect-router": "^0.2.0",
        "krubio/perfect-session": "^0.1.2",
        "krubio/perfect-logger": "^0.1.0",
        "krubio/perfect-database": "^0.1.0",
        "krubio/perfect-container-psr-11": "^2.0",
        "ext-pdo": "*",
        "ext-ctype": "*",
        "ext-zip": "*"
    },
    "autoload": {
        "psr-4": {
            "PerfectConsign\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PerfectConsign\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "ext-xdebug": "*",
        "chrome-php/chrome": "1.16",
        "codeception/codeception": "5.3.7",
        "codeception/module-asserts": "3.2",
        "codeception/module-phpbrowser": "3.0",
        "phpmd/phpmd": "2.15",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "13.3.5"
    },
    "scripts": {
        "check:max-lines": "php bin/check-max-lines.php 500",
        "check:freeze": "php bin/check-migration-freeze.php",
        "check:phpmd": "php -d error_reporting=\"E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED\" vendor/bin/phpmd src text phpmd.xml",
        "probe:phpmd": "php bin/phpmd-probe-rule.php",
        "phpstan": "php vendor/bin/phpstan analyse --memory-limit=512M",
        "test": "php vendor/bin/phpunit --testsuite unit",
        "test:integration": "php vendor/bin/phpunit --testsuite integration",
        "prove": "php bin/prove-suite.php",
        "prove:obligations": "php bin/prove-obligations.php",
        "prove:race": "php bin/prove-race.php",
        "prove:tenant": "php bin/prove-tenant.php",
        "build:routes": "@php bin/build-feature-routes.php",
        "check:worker": "php bin/check-worker.php",
        "test:smoke": "php vendor/bin/phpunit --testsuite http --group smoke",
        "test:http": "php vendor/bin/phpunit --testsuite http --exclude-group surface-mutate",
        "test:surface-mutate": "php vendor/bin/phpunit --testsuite http --group surface-mutate",
        "test:browser": "php vendor/bin/phpunit --testsuite browser",
        "codecept:build": "php vendor/bin/codecept build",
        "test:functional": [
            "@codecept:build",
            "php -d display_errors=0 -d xdebug.mode=off vendor/bin/codecept run functional --no-ansi"
        ],
        "test:acceptance": [
            "@codecept:build",
            "php -d display_errors=0 -d xdebug.mode=off vendor/bin/codecept run acceptance --no-ansi"
        ],
        "test:codeception": [
            "@codecept:build",
            "php -d display_errors=0 -d xdebug.mode=off vendor/bin/codecept run functional,acceptance --no-ansi"
        ],
        "test:coverage": "php bin/coverage-run.php",
        "test:mutate": "php bin/mutate.php",
        "check": [
            "@check:freeze",
            "@check:max-lines",
            "@check:phpmd",
            "@phpstan",
            "@test",
            "@test:integration",
            "@test:http",
            "@prove:obligations",
            "@prove:race",
            "@prove",
            "@prove:tenant",
            "@check:worker"
        ]
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true
    }
}
